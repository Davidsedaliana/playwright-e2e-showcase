{
  "name": "playwright-e2e-showcase",
  "version": "1.0.0",
  "description": "E2E and API test showcase: Playwright + TypeScript + Page Object Model, Allure report on GitHub Pages",
  "author": "David Tirayan",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.10.2"
  }
}
